# PostgreSQL connection string
# Nama database mengikuti SOP: {project_code}_{environment}_{year} (huruf kecil)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hriscms_dev_2026

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Alamat hris-cms ini, tanpa trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Alamat situs hris-landing, dipakai untuk CORS, preview, dan revalidate
LANDING_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Harus sama dengan PREVIEW_SECRET dan REVALIDATE_SECRET di hris-landing
PREVIEW_SECRET=YOUR_SECRET_HERE
REVALIDATE_SECRET=YOUR_SECRET_HERE
